; test_bitwise.ja
    MOV8 R0, 10
    MOV8 R1, 12
    
    ; AND
    MOV32 R2, 0
    ADD R2, R0
    AND R2, R1
    INTOUT R2
    MOV8 R3, 10
    CHAROUT R3
    
    ; OR
    MOV32 R2, 0
    ADD R2, R0
    OR R2, R1
    INTOUT R2
    CHAROUT R3
    
    ; XOR
    MOV32 R2, 0
    ADD R2, R0
    XOR R2, R1
    INTOUT R2
    CHAROUT R3
    
    ; BITNOT
    MOV8 R2, 10
    BITNOT R2
    INTOUT R2
    CHAROUT R3
    
    ; SHL
    MOV8 R2, 8
    MOV8 R4, 2
    SHL R2, R4
    INTOUT R2
    CHAROUT R3
    
    ; SHR
    MOV8 R2, 32
    SHR R2, R4
    INTOUT R2
    CHAROUT R3
    
    HALT