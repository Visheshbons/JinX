BOOLMOV R0, TRUE
BOOLMOV R1, FALSE
MOV8 R2, '\n'

BOOLAND R0, R1    ; R0 = R0 AND R1
INTOUT R0 ; 0
CHAROUT R2
BOOLMOV R0, TRUE
BOOLOR R0, R1    ; R0 = R0 OR R1
INTOUT R0 ; 1
CHAROUT R2
BOOLMOV R0, TRUE
BOOLNOT R0       ; R0 = NOT R0
INTOUT R0 ; 0
CHAROUT R2
BOOLMOV R0, TRUE
BOOLXOR R0, R1    ; R0 = R0 XOR R1
INTOUT R0 ; 1
CHAROUT R2
HALT